<launch>
  <arg name="base_frame"   default="base_link"/>
  <arg name="camera_frame" default="camera_color_optical_frame
"/>

  <arg name="color_topic"  default="/camera/color/image_raw"/>
  <arg name="depth_topic"  default="/camera/aligned_depth_to_color/image_raw"/>
  <arg name="camera_info"  default="/camera/color/camera_info"/>

  <arg name="calib_name" default="ur3_realsense_handeyecalibration_eye_on_base"/>
  <arg name="calib_dir"  default="$(env HOME)/.ros/easy_handeye"/>

  <include file="$(find handeye_test)/launch/publish_handeye_tf.launch">
    <arg name="calib_name" value="$(arg calib_name)"/>
    <arg name="calib_dir"  value="$(arg calib_dir)"/>
  </include>

  <node pkg="handeye_test" type="without_gripper.py" name="click_to_point" output="screen">
    <param name="base_frame"   value="$(arg base_frame)"/>
    <param name="camera_frame" value="$(arg camera_frame)"/>
    <param name="color_topic"  value="$(arg color_topic)"/>
    <param name="depth_topic"  value="$(arg depth_topic)"/>
    <param name="camera_info"  value="$(arg camera_info)"/>
  </node>
</launch>
