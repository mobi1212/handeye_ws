<launch>
  <!-- 座標系統 -->
  <arg name="base_frame"   default="base_link"/>
  <arg name="camera_frame" default="camera_link"/>

  <!-- 相機 topic：依你的 Realsense 調整 -->
  <arg name="color_topic"  default="/camera/color/image_raw"/>
  <arg name="depth_topic"  default="/camera/aligned_depth_to_color/image_raw"/>
  <arg name="camera_info"  default="/camera/color/camera_info"/>

  <!-- 夾爪 TCP -->
  <arg name="gripper_host" default="192.168.86.7"/>
  <arg name="gripper_port" default="63352"/>

  <!-- 放置位姿（現場可改） -->
  <arg name="place_x"  default="0.20"/>
  <arg name="place_y"  default="0.15"/>
  <arg name="place_z"  default="0.21"/>
  <arg name="place_qx" default="-0.998"/>
  <arg name="place_qy" default="0.057"/>
  <arg name="place_qz" default="-0.030"/>
  <arg name="place_qw" default="0.0014"/>

  <!-- 手眼 YAML 檔 -->
  <arg name="calib_name" default="ur3_realsense_handeyecalibration_eye_on_base"/>
  <arg name="calib_dir"  default="$(env HOME)/.ros/easy_handeye"/>

  <!-- 先發 TF -->
  <include file="$(find handeye_test)/launch/publish_handeye_tf.launch">
    <arg name="calib_name" value="$(arg calib_name)"/>
    <arg name="calib_dir"  value="$(arg calib_dir)"/>
  </include>

  <!-- 主程式 -->
  <node pkg="handeye_test" type="click_and_pick.py" name="click_to_pick" output="screen">
    <param name="base_frame"   value="$(arg base_frame)"/>
    <param name="camera_frame" value="$(arg camera_frame)"/>

    <param name="color_topic"  value="$(arg color_topic)"/>
    <param name="depth_topic"  value="$(arg depth_topic)"/>
    <param name="camera_info"  value="$(arg camera_info)"/>

    <param name="gripper_host" value="$(arg gripper_host)"/>
    <param name="gripper_port" value="$(arg gripper_port)"/>

    <param name="place_pose/x"  value="$(arg place_x)"/>
    <param name="place_pose/y"  value="$(arg place_y)"/>
    <param name="place_pose/z"  value="$(arg place_z)"/>
    <param name="place_pose/qx" value="$(arg place_qx)"/>
    <param name="place_pose/qy" value="$(arg place_qy)"/>
    <param name="place_pose/qz" value="$(arg place_qz)"/>
    <param name="place_pose/qw" value="$(arg place_qw)"/>
  </node>
</launch>

